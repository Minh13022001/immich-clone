# Copy to docker/.env to override the compose defaults.
# These are consumed by docker/docker-compose.dev.yml.

DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Published host ports. Override any of these when the default is taken *on the
# host*. A machine that runs a real Immich install and a host-run checkout of
# this repo usually has all three occupied:
#
#   5432  another Postgres — often this project's own `database` container on a
#         second Docker daemon, e.g. the system daemon while the CLI talks to
#         Docker Desktop. Check with `docker --context default ps`; `docker ps`
#         alone will look empty and hide it.
#   2283  a real Immich server
#   3000  the host-run web dev server (pnpm dev:web)
#
# Only the host side moves; container-internal ports stay 5432/2283/3000, so
# nothing inside the compose network needs updating. Check before choosing:
#
#   ss -lnt | grep -E ':(5432|2283|3000)\b'
#
# DB_HOST_PORT=5433
# SERVER_HOST_PORT=2285
# WEB_HOST_PORT=3001
#
# Moving DB_HOST_PORT gives the stack its own Postgres when the default port
# belongs to a container on another daemon. Each daemon keeps its own volumes,
# so the existing data is not lost — it stays in the other daemon's
# postgres_data volume. Pair the change with DB_PORT in server/.env whenever the
# API runs on the host.
