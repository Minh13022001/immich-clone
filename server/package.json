{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "license": "GNU Affero General Public License version 3",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write --list-different .",
    "migrations:run": "tsx src/bin/migrate.ts up",
    "migrations:rollback": "tsx src/bin/migrate.ts down",
    "schema:reset": "tsx src/bin/migrate.ts reset"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.4",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.4",
    "@nestjs/platform-express": "^11.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kysely": "^0.28.17",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "eslint": "^9.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.28.0"
  }
}
