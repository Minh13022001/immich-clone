# Copy to .env for local development (outside Docker).
# Inside Docker these are supplied by docker/docker-compose.dev.yml.

NODE_ENV=development
PORT=2283

DB_HOST=localhost
# Must match DB_HOST_PORT in docker/.env when Postgres runs in Docker, and the
# host port of whatever Postgres this API is actually pointed at.
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
