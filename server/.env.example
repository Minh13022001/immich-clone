# Copy to .env for local development (outside Docker).
# Inside Docker these are supplied by docker/docker-compose.dev.yml.

NODE_ENV=development
PORT=2283

DB_HOST=localhost
# Must match DB_HOST_PORT in docker/.env when Postgres runs in Docker, and the
# host port of whatever Postgres this API is actually pointed at.
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Filesystem root for uploaded originals (relative paths resolve from server/).
# With STORAGE_BACKEND=s3 it only holds the local backend's `objects/` tree and
# any files written before the cut-over.
MEDIA_ROOT=./data

# --- Object storage ---------------------------------------------------------
#
# `local` (default) keeps the old behaviour: the API owns the bytes under
# MEDIA_ROOT and serves presigned-style upload links from itself. `s3` switches
# every upload and read to the object store.
STORAGE_BACKEND=local

# Absolute base URL the API is reachable at from a browser. The local backend
# signs its own PUT links against this host.
PUBLIC_API_URL=http://localhost:2283

# Secret for those local upload tokens. Change it per environment; rotating it
# invalidates links already handed out, which is exactly what you want after a
# leak.
UPLOAD_TOKEN_SECRET=dev-upload-token-secret

# Lifetime of a presigned URL; also the deadline for finishing the upload.
PRESIGN_TTL_SECONDS=900
# Abandoned sessions older than this are aborted and their quota refunded.
UPLOAD_SESSION_TTL_SECONDS=3600

# Single-request uploads above MULTIPART_THRESHOLD switch to multipart, in
# PART_SIZE chunks. MAX_UPLOAD_SIZE is the ceiling enforced before any URL is
# issued.
MULTIPART_THRESHOLD=67108864
PART_SIZE=8388608
MAX_UPLOAD_SIZE=21474836480

# S3-compatible endpoint, reachable from the API process. Leave empty on real AWS.
# Required when STORAGE_BACKEND=s3.
S3_ENDPOINT=http://localhost:9000
# Same store, but reached the way the *browser* reaches it. Signing uses this
# host because the signature covers the Host header. On real AWS this is the
# bucket's public endpoint, or can be left empty to fall back to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=immich-clone
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO and most self-hosted gateways serve path-style URLs; AWS does not.
S3_FORCE_PATH_STYLE=false
