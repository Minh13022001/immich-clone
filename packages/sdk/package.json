    "format:fix": "prettier --cache --write --list-different ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.28.0"
  }
}
