# Keep the store local to the repo so Docker bind-mounts behave predictably.
# The reference relies on pnpm's default global store plus named volumes; for a
# small project a repo-local store is simpler to reason about.
store-dir=.pnpm-store

# Fail fast if the lockfile and package.json disagree (CI-safe default).
frozen-lockfile=false

# Hoist nothing. Strict node_modules is the whole point of pnpm and it catches
# phantom dependencies early, which matters more in a monorepo.
shamefully-hoist=false
